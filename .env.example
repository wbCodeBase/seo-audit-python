# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys. On Vercel, set the same
# names under Project → Settings → Environment Variables.

# ── AI apps (at least one) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model fallback lists (first one that exists is used)
# CLAUDE_MODELS=claude-sonnet-5,claude-opus-4-8
# OPENAI_MODELS=gpt-5.1,gpt-5,gpt-4.1

# ── Google Sheet (settings input + optional Results dual-write) ───────────
GOOGLE_SHEET_ID=
# Service-account key JSON, raw or base64-encoded
GOOGLE_SERVICE_ACCOUNT_JSON=
# Shared secret for /api/scheduled_audit (Vercel Cron sends it automatically)
CRON_SECRET=

# ── Database (Supabase Postgres) ──────────────────────────────────────────
# Supabase → Connect → "Transaction pooler" (port 6543). Used by the app/Vercel.
DATABASE_URL=
# Supabase → Connect → "Session pooler" (port 5432). Used for migrations/imports.
DATABASE_URL_DIRECT=

# ── Audit behaviour ───────────────────────────────────────────────────────
# Keep writing the "Results - <App>" tabs alongside the DB until you switch it off
SHEETS_DUAL_WRITE=true
# How many times each question is asked per app per run (answers vary run to run)
REPEATS_PER_RUN=1
# Flag brands the AI names that you don't track yet (one cheap Haiku call per answer)
DISCOVERY_ENABLED=true
# DISCOVERY_MODEL=claude-haiku-5-5
# Score how positively each answer portrays the client (one cheap Haiku call per answer naming it)
SENTIMENT_ENABLED=true
# SENTIMENT_MODEL=claude-haiku-5-5
# Days the nightly metrics job recomputes (late/re-run answers are picked up)
METRICS_DAYS=7
# MAX_WORKERS=6

# ── Supabase browser keys (not used by the backend; for the dashboard later) ─
NEXT_PUBLIC_SUPABASE_URL=https://vrlsyxrxfzqwqmwngqry.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Legacy: only for the interactive ai_rank_* / audit_* tools ────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
