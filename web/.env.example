# Copy to .env.local (local) / set in the Vercel project for web/.
# Supabase → Project Settings → API. Both are public by design; the database's
# Row Level Security decides what each signed-in user can see.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Supabase → Project Settings → API Keys → Secret key.
# Lets admins create accounts / set passwords from the Users page. Never
# prefix it with NEXT_PUBLIC_ — it must not reach the browser.
SUPABASE_SECRET_KEY=
